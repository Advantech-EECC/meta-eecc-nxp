From f9a24b6ab233269cb9d22b816145ee006f5536ef Mon Sep 17 00:00:00 2001
From: SeanChuang2 <dinner0828@gmail.com>
Date: Thu, 24 Jul 2025 13:34:12 +0800
Subject: [PATCH] dts: Support w25q64 SPI nor flash

Upstream-Status: Inappropriate [other]
---
 arch/arm/dts/imx95-aom5521-a2-u-boot.dtsi |  4 ----
 arch/arm/dts/imx95-aom5521-a2.dts         | 19 ++++++-------------
 2 files changed, 6 insertions(+), 17 deletions(-)

diff --git a/arch/arm/dts/imx95-aom5521-a2-u-boot.dtsi b/arch/arm/dts/imx95-aom5521-a2-u-boot.dtsi
index 45967c73835..f2082b3f7d3 100644
--- a/arch/arm/dts/imx95-aom5521-a2-u-boot.dtsi
+++ b/arch/arm/dts/imx95-aom5521-a2-u-boot.dtsi
@@ -115,10 +115,6 @@
 
 &flexspi1 {
 	bootph-pre-ram;
-
-	flash@0{
-		bootph-pre-ram;
-	};
 };
 
 &pinctrl_flexspi1 {
diff --git a/arch/arm/dts/imx95-aom5521-a2.dts b/arch/arm/dts/imx95-aom5521-a2.dts
index 1bceac0f6e7..869db0c02e6 100644
--- a/arch/arm/dts/imx95-aom5521-a2.dts
+++ b/arch/arm/dts/imx95-aom5521-a2.dts
@@ -198,17 +198,14 @@
 	pinctrl-0 = <&pinctrl_flexspi1>;
 	status = "okay";
 
-	flash@0 {
-		compatible = "jedec,spi-nor";
+	flash0: w25q64jwssiq@0 {
+		compatible = "jedec,spi-nor", "winbond,w25q64";
 		reg = <0>;
-		pinctrl-names = "default";
-		pinctrl-0 = <&pinctrl_flexspi1_reset>;
-		reset-gpios = <&gpio5 11 GPIO_ACTIVE_LOW>;
 		#address-cells = <1>;
 		#size-cells = <1>;
-		spi-max-frequency = <200000000>;
-		spi-tx-bus-width = <8>;
-		spi-rx-bus-width = <8>;
+		spi-max-frequency = <29000000>;
+		spi-tx-bus-width = <4>;
+		spi-rx-bus-width = <4>;
 	};
 };
 
@@ -433,16 +430,12 @@
 	pinctrl_flexspi1: flexspi1grp {
 		fsl,pins = <
 			IMX95_PAD_XSPI1_SS0_B__FLEXSPI1_A_SS0_B			0x3fe
+			IMX95_PAD_XSPI1_SS1_B__FLEXSPI1_A_SS1_B			0x3fe
 			IMX95_PAD_XSPI1_SCLK__FLEXSPI1_A_SCLK			0x3fe
-			IMX95_PAD_XSPI1_DQS__FLEXSPI1_A_DQS			0x3fe
 			IMX95_PAD_XSPI1_DATA0__FLEXSPI1_A_DATA_BIT0		0x3fe
 			IMX95_PAD_XSPI1_DATA1__FLEXSPI1_A_DATA_BIT1		0x3fe
 			IMX95_PAD_XSPI1_DATA2__FLEXSPI1_A_DATA_BIT2		0x3fe
 			IMX95_PAD_XSPI1_DATA3__FLEXSPI1_A_DATA_BIT3		0x3fe
-			IMX95_PAD_XSPI1_DATA4__FLEXSPI1_A_DATA_BIT4		0x3fe
-			IMX95_PAD_XSPI1_DATA5__FLEXSPI1_A_DATA_BIT5		0x3fe
-			IMX95_PAD_XSPI1_DATA6__FLEXSPI1_A_DATA_BIT6		0x3fe
-			IMX95_PAD_XSPI1_DATA7__FLEXSPI1_A_DATA_BIT7		0x3fe
 		>;
 	};
 
