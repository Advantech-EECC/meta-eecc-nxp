From 17930df59947bbc5e5e98afbc6767feefd5a513b Mon Sep 17 00:00:00 2001
From: "Mikhail Tsukerman" <mikhail.tsukerman@advantech.de>
Date: Tue, 10 Feb 2026 15:39:20 +0100
Subject: [PATCH] aom5521a1: update imx95_evk.h

We have only 8Gb of RAM

Upstream-Status: Inappropriate [other]
Signed-off-by: Mikhail Tsukerman <mikhail.tsukerman@advantech.com>

---
 include/configs/imx95_evk.h | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

diff --git a/include/configs/imx95_evk.h b/include/configs/imx95_evk.h
index 76ed51534c6..e4da6455e0e 100644
--- a/include/configs/imx95_evk.h
+++ b/include/configs/imx95_evk.h
@@ -10,19 +10,18 @@
 #include <linux/stringify.h>
 #include <asm/arch/imx-regs.h>
 
+#define CFG_HAS_ETH1 1
+#define CFG_HAS_ETH2 1
+
 #define CFG_SYS_INIT_RAM_ADDR	0x90000000
 #define CFG_SYS_INIT_RAM_SIZE	0x200000
 
 #define CFG_SYS_SDRAM_BASE		0x90000000
 #define PHYS_SDRAM				0x90000000
 
-#define PHYS_SDRAM_SIZE			0x70000000 /* 2GB - 256MB DDR */
-#ifdef CONFIG_TARGET_IMX95_15X15_EVK
-#define PHYS_SDRAM_2_SIZE 		0x180000000UL /* 6GB */
-#else
-#define PHYS_SDRAM_2_SIZE		0x380000000 /* 14GB */
-#endif
-
+/* Totally 8GB */
+#define PHYS_SDRAM_SIZE			0x70000000UL /* 2GB  - 256MB DDR */
+#define PHYS_SDRAM_2_SIZE		0x180000000UL /* 6GB */
 #define CFG_SYS_SECURE_SDRAM_BASE	0x8A000000 /* Secure DDR region for A55, SPL could use first 2MB */
 #define CFG_SYS_SECURE_SDRAM_SIZE	0x06000000
 
-- 
2.43.0

